server {
    listen       ${PORT};
    listen       [::]:${PORT};
    server_name  _;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The static web app. Tasks live in each browser (IndexedDB) until sync is on.
    location / {
        root   /usr/share/nginx/html;
        index  index.html;
        try_files $uri $uri/ /index.html;
    }

    location = /webdav {
        return 302 /webdav/;
    }

    # Private WebDAV sync store (its own login). Same origin, so no CORS needed.
    location /webdav/ {
        set $webdav_upstream http://${WEBDAV_HOST}:${WEBDAV_PORT};
        proxy_pass $webdav_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        client_max_body_size 256m;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}
